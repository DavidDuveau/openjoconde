# Reverse proxy HTTPS devant la pile (docker-compose.https.yml). {$DOMAINE} vient de .env.
# Pour un nom de domaine public, Caddy obtient et renouvelle seul le certificat (Let's Encrypt) : les ports 80 et 443
# doivent être joignables depuis Internet. Pour « localhost », il utilise sa propre autorité (certificat à accepter à la main).
{$DOMAINE} {
	encode zstd gzip
	# Caddy remplace X-Forwarded-For par l'adresse réelle du visiteur (il ne fait pas confiance à l'en-tête reçu)
	reverse_proxy front:8080
}
