server {
    listen 8080;
    root /usr/share/nginx/html;

    # Adresse du visiteur : celle de la connexion, et l'en-tête X-Forwarded-For reçu est ignoré (le front est alors exposé
    # directement). Derrière Caddy, docker-compose.https.yml ajoute ici les proxys de confiance (nginx-realip.conf).
    include /etc/nginx/realip/*.conf;

    # L'API : même domaine que le front
    location /api/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        client_max_body_size 50m;
    }

    # Fichiers à nom haché : cache long
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Application monopage : toute autre adresse renvoie index.html
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}
