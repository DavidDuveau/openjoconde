# Copier en .env (non versionné) et renseigner les deux secrets.
# Évitez ; " ' et les espaces dans le mot de passe : il est inséré tel quel dans la chaîne de connexion.
POSTGRES_PASSWORD=
# Clé attendue dans l'en-tête X-Api-Key des routes d'administration (synchronisation, import)
API_KEY=

# Facultatif
# FRONT_PORT=8080
# SYNC_ON_STARTUP=false
# SYNC_INTERVAL_HOURS=24
# ENRICHMENT_ENABLED=false
# API_MEMORY_LIMIT=2g

# HTTPS (docker-compose.https.yml) : nom de domaine public pointant vers le serveur, ou localhost pour essayer
# DOMAINE=
# HTTP_PORT=80
# HTTPS_PORT=443
