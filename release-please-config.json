{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "openjoconde",
      "include-component-in-tag": false,
      "changelog-sections": [
        { "type": "feat", "section": "Nouveautés" },
        { "type": "fix", "section": "Corrections" },
        { "type": "perf", "section": "Performances" },
        { "type": "revert", "section": "Retraits" },
        { "type": "docs", "section": "Documentation" },
        { "type": "refactor", "section": "Refactorisation", "hidden": true },
        { "type": "test", "section": "Tests", "hidden": true },
        { "type": "build", "section": "Construction", "hidden": true },
        { "type": "ci", "section": "Intégration continue", "hidden": true },
        { "type": "chore", "section": "Maintenance", "hidden": true }
      ],
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "extra-files": [
        { "type": "xml", "path": "src/Backend/Directory.Build.props", "xpath": "//Project/PropertyGroup/Version" },
        { "type": "json", "path": "src/Frontend/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "src/Frontend/package-lock.json", "jsonpath": "$.version" },
        { "type": "json", "path": "src/Frontend/package-lock.json", "jsonpath": "$.packages[''].version" }
      ]
    }
  }
}
