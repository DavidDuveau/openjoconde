{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=openjoconde;Username=openjoconde"
  }, 
  "Logging": { 
    "LogLevel": { 
      "Default": "Information", 
      "Microsoft": "Warning", 
      "Microsoft.Hosting.Lifetime": "Information" 
    } 
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Enrichment": {
    "Enabled": false
  },
  "Sync": {
    "SourceUrl": "https://ministere-culture.s3.sbg.io.cloud.ovh.net/POP/joconde.csv",
    "MuseofileSourceUrl": "https://ministere-culture.s3.sbg.io.cloud.ovh.net/POP/museofile.csv",
    "TempDirectory": "Data/Temp",
    "CheckForUpdatesOnStartup": false,
    "IntervalHours": 24
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Security": {
    "ApiKey": ""
  },
  "AllowedHosts": "*" 
}